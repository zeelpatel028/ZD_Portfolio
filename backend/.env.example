# Email Configuration for Portfolio Contact Form
PORT=5000

# Target Email Address where contact messages are sent
RECIPIENT_EMAIL=your_email@gmail.com

# SMTP Server credentials for sending emails (Gmail App Password or SMTP provider)
# For Gmail: Use 'smtp.gmail.com', PORT 465 or 587, and an App Password from Google Account Security
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
